# Telegram Bot Token
# Получите токен у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# YouTube API Credentials
# Файл client_secrets.json должен быть в корне проекта
# Убедитесь, что у вас есть правильные credentials для YouTube API

# Настройки сервера
# Порт для веб-хуков (если используется)
PORT=8080

# Настройки логирования
LOG_LEVEL=INFO